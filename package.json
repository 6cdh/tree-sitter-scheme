{
  "name": "@6cdh/tree-sitter-scheme",
  "version": "0.24.7-1",
  "description": "Tree-sitter parser for Scheme",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "generate:r5rs": "node scripts/run-dialect.js r5rs generate",
    "build:r5rs": "node scripts/run-dialect.js r5rs build",
    "test:r5rs": "node scripts/run-dialect.js r5rs test",
    "parse:r5rs": "node scripts/run-dialect.js r5rs parse",
    "generate:r6rs": "node scripts/run-dialect.js r6rs generate",
    "build:r6rs": "node scripts/run-dialect.js r6rs build",
    "test:r6rs": "node scripts/run-dialect.js r6rs test",
    "parse:r6rs": "node scripts/run-dialect.js r6rs parse",
    "generate:r7rs": "node scripts/run-dialect.js r7rs generate",
    "build:r7rs": "node scripts/run-dialect.js r7rs build",
    "test:r7rs": "node scripts/run-dialect.js r7rs test",
    "parse:r7rs": "node scripts/run-dialect.js r7rs parse",
    "generate:chez": "node scripts/run-dialect.js chez generate",
    "build:chez": "node scripts/run-dialect.js chez build",
    "test:chez": "node scripts/run-dialect.js chez test",
    "parse:chez": "node scripts/run-dialect.js chez parse",
    "generate:guile": "node scripts/run-dialect.js guile generate",
    "build:guile": "node scripts/run-dialect.js guile build",
    "test:guile": "node scripts/run-dialect.js guile test",
    "parse:guile": "node scripts/run-dialect.js guile parse"
  },
  "author": "6cdh",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.24.7"
  },
  "files": [
    "grammar.js",
    "grammar/**",
    "dialects/**",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "tree-sitter.json",
    "*.wasm"
  ]
}
